# Copy to .env and replace ALL password placeholders before starting Compose.
S4_DB_OWNER_PASSWORD=replace-with-random-owner-password
S4_DB_APP_PASSWORD=replace-with-different-random-app-password
S4_DATABASE_URL=postgresql+asyncpg://s4_app:replace-with-different-random-app-password@127.0.0.1:55434/s4_dev
S4_MIGRATION_DATABASE_URL=postgresql+asyncpg://s4_owner:replace-with-random-owner-password@127.0.0.1:55434/s4_dev
S4_TEST_DATABASE_URL=postgresql+asyncpg://s4_owner:replace-with-random-owner-password@127.0.0.1:55434/s4_test
S4_DATA_DIR=./var
S4_COOKIE_SECURE=false
S4_SESSION_HOURS=12
S4_ALLOWED_ORIGIN=http://localhost:5174
# Compose gateway origin, e.g. https://s4.example.internal. Blank uses request origin.
S4_PUBLIC_ORIGIN=
S4_RECEIPT_TOKEN=
S4_IMPORT_TOKEN=
S4_IMPORT_SERVICE_USER_ID=
S4_LOGIN_LIMIT=8
S4_MAX_IMPORT_BYTES=20000000
S4_EXTERNAL_ALIGNMENT_CONFIRMED=false
S4_RECONCILE_INTERVAL_SECONDS=300
S4_WORKER_HEARTBEAT_SECONDS=15
S4_WORKER_LEASE_SECONDS=120
S4_WORKER_MAX_ATTEMPTS=3
S4_OPERATIONS_PENDING_WARNING_SECONDS=300
S4_OPERATIONS_RECEIPT_WARNING_SECONDS=86400
