      "title": "UnitResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "openkb.s3-s4.v2",
      "title": "Contract Version",
      "type": "string"
    },
    "mode": {
      "enum": [
        "demo",
        "formal"
      ],
      "title": "Mode",
      "type": "string"
    },
    "batch_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Batch Id",
      "type": "string"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/Unit"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Units",
      "type": "array"
    },
    "s3_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/S3Report"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_manifest": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Manifest"
    },
    "checksums": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checksums"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "mode",
    "batch_id",
    "source_revision",
    "units"
  ],
  "title": "SourceEnvelope",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
