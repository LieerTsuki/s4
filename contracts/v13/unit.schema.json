          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Type"
    },
    "seed_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed Id"
    },
    "domain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "title": "Domains",
      "type": "array"
    },
    "track": {
      "default": "PRIVATE",
      "enum": [
        "PUBLIC",
        "PRIVATE"
      ],
      "title": "Track",
      "type": "string"
    },
    "version_locked": {
      "default": false,
      "title": "Version Locked",
      "type": "boolean"
    },
    "evaluation_k": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation K"
    },
    "time_context": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Context"
    },
    "scope_context": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Context"
    },
    "acl_context": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acl Context"
    },
    "access_context": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Context"
    },
    "reasoning_chain": {
      "items": {},
      "title": "Reasoning Chain",
      "type": "array"
    },
    "key_facts": {
      "items": {
        "type": "string"
      },
      "title": "Key Facts",
      "type": "array"
    },
    "source_case_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Source Case Ids",
      "type": "array"
    },
    "source_dataset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Dataset"
    },
    "resolved_sources": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Resolved Sources",
      "type": "array"
    },
    "same_intent_confirmation": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Same Intent Confirmation"
    },
    "source_composition": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Composition"
